# A small convolutional network for 28x28 grayscale images (NCHW layout).
# Return types can compute dimensions from shape symbols: H / 2, W / 2.

fn conv_block(x: f32[N, C, H, W], k: f32[O, C, 3, 3], b: f32[O, 1, 1]) -> f32[N, O, H / 2, W / 2] {
  return maxpool2d(relu(conv2d(x, k, padding=1) + b), size=2)
}

fn main(img: f32[16, 1, 28, 28],
        const k1: f32[16, 1, 3, 3],  const c1: f32[16, 1, 1],
        const k2: f32[32, 16, 3, 3], const c2: f32[32, 1, 1],
        const wf: f32[1568, 10],     const bf: f32[10]) -> f32[16, 10] {
  let h1 = conv_block(img, k1, c1)     # [16, 16, 14, 14]
  let h2 = conv_block(h1, k2, c2)      # [16, 32, 7, 7]
  return softmax(flatten(h2) @ wf + bf)
}
